DATABASE_URL=postgresql://rss:rss@localhost:5432/rss_reader
REDIS_URL=redis://localhost:6379
PORT=3001

FEED_UPDATE_THREADS=4
DEFAULT_SCAN_INTERVAL_MINUTES=30
MIN_SCAN_INTERVAL_NATIVE=5
MIN_SCAN_INTERVAL_BRIDGE=30
MAX_SCAN_INTERVAL_MINUTES=180
DEFAULT_MAX_ENTRIES=20
DEFAULT_INACTIVE_LIMIT_DAYS=180
FEED_LOAD_TIMEOUT_MS=25000

# Ordered, comma-separated bridge instances tried in order with failover (module 1).
INSTAGRAM_BRIDGE_INSTANCES=http://localhost:1200
INSTAGRAM_BRIDGE_ROUTE=/picnob/user/:username
TIKTOK_BRIDGE_INSTANCES=http://localhost:1200
TIKTOK_BRIDGE_ROUTE=/tiktok/user/@:username

# Combined-deploy mode (single Render Web Service running API + worker + static frontend).
# Set both to "false" for local dev with frontend/worker running as separate processes.
RUN_WORKER_IN_PROCESS=true
SERVE_FRONTEND=true
FRONTEND_DIST_PATH=../../frontend/dist
