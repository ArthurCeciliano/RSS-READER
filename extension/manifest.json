{
  "manifest_version": 3,
  "name": "RSS Reader - Instagram Bridge",
  "version": "1.0.1",
  "description": "Fetches Instagram posts for profiles imported into your self-hosted RSS Reader, using your own logged-in browser session, and pushes them to your server.",
  "permissions": ["storage", "scripting", "tabs"],
  "host_permissions": ["https://www.instagram.com/*", "http://179.197.226.119:3001/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://179.197.226.119:8080/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_title": "RSS Reader - Instagram Bridge"
  },
  "externally_connectable": {
    "matches": ["http://179.197.226.119:8080/*"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "rss-reader-instagram-bridge@arthurceciliano",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
